# Local development without Docker
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/vivariumiq_db

# Required in production. Docker Compose falls back to a local dev value if unset.
SECRET_KEY=change-me-to-a-long-random-string

# MQTT settings, only MQTT_TLS and MQTT_BROKER usually need touching
# MQTT_TLS=true makes the listener connect to the broker over tls (port 8883)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TLS=
MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Docker Compose database passwords (optional, defaults shown)
MARIADB_PASSWORD=vivariumiq
MARIADB_ROOT_PASSWORD=root
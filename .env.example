MYSQL_ROOT_PASSWORD= -
MYSQL_DATABASE=urcast_db
MYSQL_USER=sensor
MYSQL_PASSWORD= -

DATABASE_URL= add url

SECRET_KEY= add a long random string, used to sign the login tokens

# mqtt settings, only MQTT_TLS and MQTT_BROKER usually need touching
# MQTT_TLS=true makes the listener connect to the broker over tls (port 8883)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TLS=
MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt